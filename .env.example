PORT=3000
NODE_ENV=development

# URL Base pública para construir los enlaces de códigos QR
APP_BASE_URL=http://localhost:3000

# Sesión
SESSION_SECRET=un_secreto_super_seguro_para_vps

# Credenciales de Google Service Account (JSON plano de una sola línea)
# Reemplazar con el JSON de la cuenta de servicio (sin saltos de línea)
GOOGLE_SERVICE_ACCOUNT_JSON={}

# Google OAuth 2.0 (Para el login con Google de los docentes/admins)
GOOGLE_CLIENT_ID=tu-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-tu-oauth-client-secret

# Bypass de Login para desarrollo local
MOCK_AUTH_EMAIL=admin@test.com
