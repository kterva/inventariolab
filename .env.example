PORT=3000
NODE_ENV=development

# URL Base pública para construir los enlaces de códigos QR
APP_BASE_URL=http://localhost:3000

# Sesión: secreto que firma las cookies (mínimo 32 caracteres).
# Generar uno con: openssl rand -hex 32  — en producción la app no arranca con este valor de ejemplo.
SESSION_SECRET=un_secreto_super_seguro_para_vps
# Carpeta donde se guardan las sesiones (por defecto ./sessions)
# SESSIONS_DIR=/opt/inventariolab/sessions

# Carpeta donde se guarda el permiso de Drive que un admin autoriza (refresh token).
# Debe quedar fuera del repo (por defecto ./drive-tokens, ignorada por git; se crea con modo 700).
# DRIVE_TOKENS_DIR=/opt/inventariolab/drive-tokens

# Credenciales de Google Service Account (JSON plano de una sola línea)
# Reemplazar con el JSON de la cuenta de servicio (sin saltos de línea)
GOOGLE_SERVICE_ACCOUNT_JSON={}

# Google OAuth 2.0 (Para el login con Google de los docentes/admins)
GOOGLE_CLIENT_ID=tu-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-tu-oauth-client-secret

# Bypass de Login para desarrollo local
MOCK_AUTH_EMAIL=admin@test.com

# Caché de lectura de la planilla (milisegundos)
# Cuánto tiempo se reutiliza una lectura antes de volver a consultar Google
SHEETS_CACHE_TTL_MS=30000
# Si Google falla por cuota/red, hasta qué antigüedad se sirve la última copia buena
SHEETS_CACHE_STALE_MAX_MS=600000

# ─── "Crear mi laboratorio": aviso por correo y protección contra bots ───
# Aviso por correo a quien administra el servicio cada vez que alguien crea un laboratorio
# (lleva el correo de la persona y los nombres que eligió). Sin estas variables no se envía nada.
# AVISO_CREACION_EMAIL=tu-correo@ejemplo.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=NO          # SI para el puerto 465
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=contraseña-de-aplicación
# SMTP_FROM=Inventario Laboratorio <tu-correo@gmail.com>
# Topes de laboratorios creados (valores por defecto entre paréntesis)
# CREAR_MAX_TOTAL=200        # en todo el servidor
# CREAR_MAX_POR_DIA=10       # en las últimas 24 horas
# CREAR_MAX_POR_CORREO=3     # por cuenta de Google
# CREAR_MAX_POR_IP_HORA=5    # envíos del formulario por IP y hora
# CREAR_MIN_MS=3000          # un formulario enviado más rápido que esto se rechaza
# Verificación opcional con Cloudflare Turnstile (gratis); sin estas claves no se usa
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
