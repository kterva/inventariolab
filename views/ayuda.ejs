    :root { --primary: #1a5276; --secondary: #2980b9; --bg: #f4f7f6; --text: #333; }
    body { font-family: 'Roboto', sans-serif; margin: 0; background: var(--bg); color: var(--text); line-height: 1.6; }
    nav { background: var(--primary); color: white; padding: 1rem; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100;}
    .nav-btn { background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.4); padding: 5px 15px; border-radius: 4px; color: white; text-decoration: none; font-size: 0.9rem; font-weight: bold;}
    .nav-btn:hover { background: rgba(255,255,255,0.3); }
    
    .container { max-width: 800px; margin: 2rem auto; padding: 0 1.5rem; }
    
    .header-box { text-align: center; margin-bottom: 2rem; }
    .header-box h1 { color: var(--primary); margin-bottom: 0.5rem; }
    .header-box p { color: #7f8c8d; font-size: 1.1rem; }
    
    .toc { background: white; padding: 1.5rem; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 2rem; border-left: 4px solid var(--secondary); }
    .toc h3 { margin-top: 0; color: var(--primary); }
    .toc ul { list-style: none; padding-left: 0; margin: 0; }
    .toc li { margin-bottom: 0.5rem; }
    .toc a { color: var(--secondary); text-decoration: none; font-weight: bold; }
    .toc a:hover { text-decoration: underline; }
    
    .section { background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 2rem; scroll-margin-top: 80px; }
    .section h2 { color: var(--primary); border-bottom: 2px solid #ecf0f1; padding-bottom: 0.5rem; margin-top: 0; display: flex; align-items: center; gap: 10px;}
    .section h3 { color: var(--secondary); margin-top: 1.5rem; }
    
    .step { display: flex; margin-bottom: 1rem; }
    .step-number { background: var(--secondary); color: white; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; flex-shrink: 0; margin-right: 15px; margin-top: 3px;}
    .step-content { flex-grow: 1; }
    
    .alert { background: #fff3cd; color: #856404; padding: 1rem; border-left: 4px solid #ffeeba; border-radius: 4px; margin: 1rem 0; font-size: 0.95rem; }
    .info { background: #e8f4f8; color: #1a5276; padding: 1rem; border-left: 4px solid #bce0ee; border-radius: 4px; margin: 1rem 0; font-size: 0.95rem; }
    
    table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
    th { background-color: #f8f9fa; color: var(--primary); }
    
    code { background: #f1f2f6; padding: 2px 6px; border-radius: 4px; font-family: monospace; color: #e74c3c; font-size: 0.95em;}
    
    footer { text-align: center; padding: 2rem; color: #95a5a6; font-size: 0.85rem; }
